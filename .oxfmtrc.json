{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/build/**",
    "**/.react-router/**",
    "**/.wrangler/**",
    "**/worker-configuration.d.ts",
    "**/*.generated.*",
    "artifacts/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "bun.lock",
    "packages/assets/data/**",
    "output/**"
  ]
}
