{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "commands": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "document.update"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "style.update"
              },
              "patch": {
                "type": "object",
                "properties": {
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "font": {
                    "type": "string",
                    "enum": [
                      "sans",
                      "serif"
                    ]
                  },
                  "fontSize": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 16
                  },
                  "spacing": {
                    "type": "number",
                    "minimum": 12,
                    "maximum": 40
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "patch"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "section.create"
              },
              "section": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "blockIds": {
                    "minItems": 0,
                    "maxItems": 0,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "blockIds"
                ],
                "additionalProperties": false
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "section"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "section.update"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "section.delete"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "section.reorder"
              },
              "ids": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                }
              }
            },
            "required": [
              "type",
              "ids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "block.create"
              },
              "sectionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              },
              "block": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "heading",
                      "text",
                      "subtitle",
                      "meta",
                      "bullet"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sectionId",
              "block"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "block.update"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              },
              "patch": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "heading",
                      "text",
                      "subtitle",
                      "meta",
                      "bullet"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "id",
              "patch"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "block.delete"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "block.reorder"
              },
              "sectionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
              },
              "ids": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                }
              }
            },
            "required": [
              "type",
              "sectionId",
              "ids"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "actor",
    "commands"
  ],
  "additionalProperties": false
}
