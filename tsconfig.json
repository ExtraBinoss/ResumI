{
  "include": ["**/*.ts", "**/*.tsx", "apps/web/.react-router/types/**/*"],
  "exclude": ["node_modules", "**/build", "artifacts"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["apps/web/src/*"] },
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "vite/client"],
    "rootDirs": [".", "apps/web", "apps/web/.react-router/types"]
  }
}
