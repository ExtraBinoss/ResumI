"type ResumeLayout =\n  | \"studio\"\n  | \"editorial\"\n  | \"classic\"\n  | \"profile\"\n  | \"harvard\"\n  | \"cobalt\"\n  | \"atelier\"\n  | \"timeline\"\n  | \"consultant\"\n  | \"mosaic\";\ntype ResumeSection = {\n  id?: string;\n  title: string;\n  blocks: { id?: string; kind: string; text: string }[];\n};\ntype ResumeData = {\n  name: string;\n  accent: string;\n  serif: boolean;\n  layout?: ResumeLayout;\n  portrait?: string;\n  portraitAsset?: boolean;\n  font?: string;\n  license?: string;\n  brands?: TemplateBrand[];\n  brandAssets?: boolean;\n  sections: ResumeSection[];\n};\n\ntype TemplateBrand = {\n  name: string;\n  viewBox: string;\n  source: string;\n  license: string;\n  parts: { path: string; fill: string; fillRule?: \"nonzero\" | \"evenodd\" }[];\n};\n\n\n// Vetted Lucide paths (ISC); the portable template embeds its licenses with the font.\nfunction ContactIcon({\n  type,\n}: {\n  type: \"mail\" | \"location\" | \"web\" | \"phone\";\n}) {\n  return (\n    <svg\n      viewBox=\"0 0 24 24\"\n      width=\"14\"\n      height=\"14\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"1.6\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      {type === \"mail\" ? (\n        <>\n          <path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\" />\n          <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\" />\n        </>\n      ) : type === \"location\" ? (\n        <>\n          <path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\" />\n          <circle cx=\"12\" cy=\"10\" r=\"3\" />\n        </>\n      ) : type === \"web\" ? (\n        <>\n          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n          <path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20\" />\n        </>\n      ) : (\n        <path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\" />\n      )}\n    </svg>\n  );\n}\nfunction Contacts({\n  values,\n  icons = true,\n}: {\n  values: string[];\n  icons?: boolean;\n}) {\n  return (\n    <address className=\"cv-contacts\">\n      {values.map((value, index) => {\n        const type = value.includes(\"@\")\n          ? \"mail\"\n          : /^\\+?[\\d ()-]{7,}$/.test(value)\n            ? \"phone\"\n            : /\\.[a-z]{2,}/i.test(value)\n              ? \"web\"\n              : \"location\";\n        const href =\n          type === \"mail\"\n            ? `mailto:${value}`\n            : type === \"web\"\n              ? /^https?:\\/\\//i.test(value)\n                ? value\n                : `https://${value}`\n              : type === \"phone\"\n                ? `tel:${value.replace(/[^+\\d]/g, \"\")}`\n                : undefined;\n        return (\n          <span key={index}>\n            {icons && <ContactIcon type={type} />}\n            {href ? <a href={href}>{value}</a> : <span>{value}</span>}\n          </span>\n        );\n      })}\n    </address>\n  );\n}\nfunction entries(section: ResumeSection) {\n  const groups: {\n    title?: ResumeSection[\"blocks\"][number];\n    meta?: ResumeSection[\"blocks\"][number];\n    body: ResumeSection[\"blocks\"];\n  }[] = [];\n  for (const block of section.blocks) {\n    if (block.kind === \"subtitle\") groups.push({ title: block, body: [] });\n    else {\n      if (!groups.length) groups.push({ body: [] });\n      const current = groups[groups.length - 1];\n      if (block.kind === \"meta\" && current.title && !current.meta)\n        current.meta = block;\n      else current.body.push(block);\n    }\n  }\n  return groups;\n}\nfunction Section({ section }: { section: ResumeSection }) {\n  const skills = /skill|competenc|compétenc/i.test(section.title);\n  return (\n    <section\n      className={`cv-section${skills ? \" cv-skills-section\" : \"\"}`}\n      data-section-id={section.id}\n    >\n      {section.title && <h2>{section.title}</h2>}\n      <div className=\"cv-section-content\">\n        {skills ? (\n          <ul className=\"cv-skill-list\">\n            {section.blocks\n              .flatMap((block) => block.text.split(/\\s+\\/\\s+|\\n/))\n              .filter(Boolean)\n              .map((skill, index) => (\n                <li key={index}>{skill.trim()}</li>\n              ))}\n          </ul>\n        ) : (\n          entries(section).map((entry, index) => (\n            <div className=\"cv-entry\" key={index}>\n              {(entry.title || entry.meta) && (\n                <div className=\"cv-entry-head\">\n                  {entry.title && (\n                    <h3 data-block-id={entry.title.id}>{entry.title.text}</h3>\n                  )}\n                  {entry.meta && (\n                    <p className=\"cv-meta\" data-block-id={entry.meta.id}>\n                      {entry.meta.text}\n                    </p>\n                  )}\n                </div>\n              )}\n              {entry.body\n                .filter((block) => block.kind !== \"bullet\")\n                .map((block, blockIndex) => (\n                  <p\n                    className={\n                      block.kind === \"meta\" ? \"cv-meta\" : \"cv-paragraph\"\n                    }\n                    data-block-id={block.id}\n                    key={blockIndex}\n                  >\n                    {block.text}\n                  </p>\n                ))}\n              {entry.body.some((block) => block.kind === \"bullet\") && (\n                <ul className=\"cv-bullets\">\n                  {entry.body\n                    .filter((block) => block.kind === \"bullet\")\n                    .map((block, blockIndex) => (\n                      <li data-block-id={block.id} key={blockIndex}>\n                        {block.text}\n                      </li>\n                    ))}\n                </ul>\n              )}\n            </div>\n          ))\n        )}\n      </div>\n    </section>\n  );\n}\n\n/** Scoped document CSS: no application or browser-global text rules. */\nconst extendedCss = `\n.cv-sheet .cv-tools{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}\n.cv-sheet .cv-tool{display:flex;align-items:center;gap:7px;font-size:10px;line-height:1.3;color:#37434b}\n.cv-sheet .cv-tool svg{flex:none}\n.cv-sheet .cv-page-mark{display:flex;justify-content:space-between;position:absolute;bottom:31px;left:49px;right:49px;font-size:8.5px;letter-spacing:.7px;color:#7c858c}\n.cv-sheet .cv-index-label{display:block;font-size:9px;line-height:1.4;letter-spacing:2px;font-weight:600}\n.cv-sheet.cv-harvard{padding:48px 57px;font:14px/1.42 Georgia,'Times New Roman',serif;letter-spacing:0;color:#111}\n.cv-sheet.cv-harvard .cv-header{text-align:center;padding-bottom:0;margin-bottom:24px;border:0}\n.cv-sheet.cv-harvard .cv-name{font:700 26px/1.15 Georgia,'Times New Roman',serif;letter-spacing:.1px;color:#111;border-bottom:1px solid #111;padding-bottom:8px}\n.cv-sheet.cv-harvard .cv-role{display:none}\n.cv-sheet.cv-harvard .cv-contacts{justify-content:center;gap:4px 13px;margin-top:6px;font:12px/1.4 Georgia,'Times New Roman',serif;color:#111}\n.cv-sheet.cv-harvard .cv-contacts svg{display:none}\n.cv-sheet.cv-harvard .cv-section{margin-bottom:23px}\n.cv-sheet.cv-harvard .cv-section h2{text-align:center;text-transform:none;letter-spacing:0;font:700 14px/1.3 Georgia,'Times New Roman',serif;color:#111;margin-bottom:10px}\n.cv-sheet.cv-harvard .cv-entry{margin-bottom:16px}\n.cv-sheet.cv-harvard .cv-entry-head{gap:15px;margin-bottom:4px}\n.cv-sheet.cv-harvard .cv-entry h3{font:700 14px/1.4 Georgia,'Times New Roman',serif;color:#111}\n.cv-sheet.cv-harvard .cv-meta{font:12.5px/1.4 Georgia,'Times New Roman',serif;color:#111}\n.cv-sheet.cv-harvard .cv-paragraph,.cv-sheet.cv-harvard .cv-bullets{font:13px/1.48 Georgia,'Times New Roman',serif;color:#111}\n.cv-s